{
  "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
  "$id": "https://raw.githubusercontent.com/SINTEF/physmet-data-documentation-templates/refs/heads/main/schemas/People.schema.json",
  "@context": "https://raw.githubusercontent.com/SINTEF/physmet-data-documentation-templates/refs/heads/main/context/context.json",
  "title": "People",
  "type": "object",
  "properties": {
    "@id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^([A-Za-z][A-Za-z0-9\\-_]*:)?[A-Za-z0-9][A-Za-z0-9\\-_]*$"
        }
      ],
      "description": "Unique IRI identifying the documented resource.",
      "examples": [
        "pers:AndreasVollBugten"
      ]
    },
    "@type": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^([A-Za-z][A-Za-z0-9\\-_]*:)?[A-Za-z0-9][A-Za-z0-9\\-_]*$"
        }
      ],
      "description": "IRI of the class the resource belongs to.",
      "examples": [
        "foaf:Person"
      ]
    },
    "name": {
      "type": "string",
      "description": "A name of the agent.",
      "examples": [
        "Andreas Voll Bugten"
      ]
    },
    "prefix": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        "avb"
      ]
    },
    "namespace": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        "https://www.ntnu.edu/physmet/data/avb/"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        null
      ]
    },
    "affiliation": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        "org:NTNU"
      ]
    },
    "sameAs": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        "nnvaid:978376",
        "nnvaid:978376"
      ]
    }
  },
  "required": [
    "@id",
    "@type",
    "name"
  ]
}
