{
  "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
  "$id": "https://raw.githubusercontent.com/SINTEF/physmet-data-documentation-templates/refs/heads/main/schemas/Organisations.schema.json",
  "@context": "https://raw.githubusercontent.com/SINTEF/physmet-data-documentation-templates/refs/heads/main/context/context.json",
  "title": "Organisations",
  "type": "object",
  "properties": {
    "@id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^([A-Za-z][A-Za-z0-9\\-_]*:)?[A-Za-z0-9][A-Za-z0-9\\-_]*$"
        }
      ],
      "description": "Unique IRI identifying the documented resource.",
      "examples": [
        "org:EC"
      ]
    },
    "@type": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^([A-Za-z][A-Za-z0-9\\-_]*:)?[A-Za-z0-9][A-Za-z0-9\\-_]*$"
        }
      ],
      "description": "IRI of the class the resource belongs to.",
      "examples": [
        "foaf:Organization"
      ]
    },
    "name": {
      "type": "string",
      "description": "A name of the agent.",
      "examples": [
        "European Comission"
      ]
    },
    "prefix": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        "ec"
      ]
    },
    "namespace": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        "https://commission.europa.eu/"
      ]
    },
    "sameAs": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        "ror:00k4n6c32"
      ]
    }
  },
  "required": [
    "@id",
    "@type",
    "name"
  ]
}