          "pattern": "^([A-Za-z][A-Za-z0-9\\-_]*:)?[A-Za-z0-9][A-Za-z0-9\\-_]*$"
        }
      ],
      "description": "Unique IRI identifying the documented resource.",
      "examples": [
        "avb:JM"
      ]
    },
    "@type": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^([A-Za-z][A-Za-z0-9\\-_]*:)?[A-Za-z0-9][A-Za-z0-9\\-_]*$"
        }
      ],
      "description": "IRI of the class the resource belongs to.",
      "examples": [
        "emmo:ChemicalComposition"
      ]
    },
    "wp:Fe": {
      "type": [
        "number",
        "null"
      ],
      "description": "",
      "examples": [
        "0.57"
      ]
    },
    "wp:Mn": {
      "type": [
        "number",
        "null"
      ],
      "description": "",
      "examples": [
        "0.13"
      ]
    },
    "wp:C": {
      "type": [
        "number",
        "null"
      ],
      "description": "",
      "examples": [
        "0.24"
      ]
    },
    "wp:B": {
      "type": [
        "number",
        "null"
      ],
      "description": "",
      "examples": [
        "0.06"
      ]
    }
  },
  "required": [
    "@id",
    "@type"
  ]
}