{
  "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
  "$id": "https://raw.githubusercontent.com/SINTEF/physmet-data-documentation-templates/refs/heads/main/schemas/Datasets.schema.json",
  "@context": "https://raw.githubusercontent.com/SINTEF/physmet-data-documentation-templates/refs/heads/main/schema/context.json",
  "title": "Datasets",
  "type": "object",
  "properties": {
    "@id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^([A-Za-z][A-Za-z0-9\\-_]*:)?[A-Za-z0-9][A-Za-z0-9\\-_]*$"
        }
      ],
      "description": "Unique IRI identifying the documented resource.",
      "examples": [
        "avb:JM11_EDS"
      ]
    },
    "@type": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^([A-Za-z][A-Za-z0-9\\-_]*:)?[A-Za-z0-9][A-Za-z0-9\\-_]*$"
        }
      ],
      "description": "IRI of the class the resource belongs to.",
      "examples": [
        "temgo:EDSMap"
      ]
    },
    "title": {
      "type": "string",
      "description": "A name given to the resource.",
      "examples": [
        "JM11_EDS"
      ]
    },
    "description": {
      "type": "string",
      "description": "A free-text account of the resource.",
      "examples": [
        "EDS dataset for the JM11 crusible."
      ]
    },
    "comment": {
      "type": [
        "string",
        "null"
      ],
      "description": "A description of the subject resource. Use `description` instead.",
      "examples": [
        null
      ]
    },
    "keyword": {
      "type": [
        "string",
        "null"
      ],
      "description": "A keyword or tag describing the resource.",
      "examples": [
        "EDS"
      ]
    },
    "rightsHolder": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        "org:NTNU"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ],
      "description": "A licence under which the resource is made available.",
      "examples": [
        null
      ]
    },
    "creator": {
      "type": [
        "string",
        "null"
      ],
      "description": "An entity responsible for producing the resource.",
      "examples": [
        "pers:AndreasVollBugten"
      ]
    },
    "contactPerson": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        "pers:MarisaDiSabatino"
      ]
    },
    "seeAlso": {
      "type": [
        "string",
        "null"
      ],
      "description": "Indicates a resource that might provide additional information about the subject resource.",
      "examples": [
        null
      ]
    },
    "releaseDate": {
      "type": [
        "string",
        "null"
      ],
      "description": "The date of formal issuance (e.g., publication) of the resource.",
      "examples": [
        null
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Version indicator (name or identifier) of a resource.",
      "examples": [
        null
      ]
    },
    "priorRelease": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        null
      ]
    },
    "processedFrom": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        "avb:JM11"
      ]
    },
    "distribution.downloadURL": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        "https://studntnu.sharepoint.com/:f:/r/sites/o365_SFIPhysMet/Shared%20Documents/Reseach%20Areas,%20RA%20(Open%20channel)/RA%203%20Sustainable%20and%20high-performance%20material%20development/Andreas%20Voll%20Bugten%20data/JM11/SEM/EDS?csf=1&web=1&e=8vpJwN"
      ]
    }
  },
  "required": [
    "@id",
    "@type",
    "title",
    "description"
  ]
}