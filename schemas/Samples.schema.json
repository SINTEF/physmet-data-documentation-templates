{
  "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
  "$id": "https://raw.githubusercontent.com/SINTEF/physmet-data-documentation-templates/refs/heads/main/schemas/Samples.schema.json",
  "@context": "https://raw.githubusercontent.com/SINTEF/physmet-data-documentation-templates/refs/heads/main/context/context.json",
  "title": "Samples",
  "type": "object",
  "properties": {
    "@id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^([A-Za-z][A-Za-z0-9\\-_]*:)?[A-Za-z0-9][A-Za-z0-9\\-_]*$"
        }
      ],
      "description": "Unique IRI identifying the documented resource.",
      "examples": [
        "avb:JM11"
      ]
    },
    "@type": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^([A-Za-z][A-Za-z0-9\\-_]*:)?[A-Za-z0-9][A-Za-z0-9\\-_]*$"
        }
      ],
      "description": "IRI of the class the resource belongs to.",
      "examples": [
        "chameo:Sample"
      ]
    },
    "title": {
      "type": "string",
      "description": "A name given to the resource.",
      "examples": [
        "JM11"
      ]
    },
    "description": {
      "type": "string",
      "description": "A free-text account of the resource.",
      "examples": [
        "A spheroidal graphite cast iron sample with nominal boron content specified by avb:nominalBoron."
      ]
    },
    "comment": {
      "type": [
        "string",
        "null"
      ],
      "description": "A description of the subject resource. Use `description` instead.",
      "examples": [
        null
      ]
    },
    "hasComposition": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        null
      ]
    },
    "contactPerson": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        null
      ]
    },
    "creator": {
      "type": [
        "string",
        "null"
      ],
      "description": "An entity responsible for producing the resource.",
      "examples": [
        "pers:AndersVollBugten"
      ]
    },
    "creationDate": {
      "type": [
        "string",
        "null"
      ],
      "description": "Date of creation",
      "examples": [
        null
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        null
      ]
    },
    "isTemporalPartOf": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        null
      ]
    },
    "isSpatioTemporalPartOf": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        null
      ]
    }
  },
  "required": [
    "@id",
    "@type",
    "title",
    "description"
  ]
}
