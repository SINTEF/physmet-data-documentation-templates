{
  "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
  "$id": "https://raw.githubusercontent.com/SINTEF/physmet-data-documentation-templates/refs/heads/main/schemas/Equipments.schema.json",
  "@context": "https://raw.githubusercontent.com/SINTEF/physmet-data-documentation-templates/refs/heads/main/context/context.json",
  "title": "Equipments",
  "type": "object",
  "properties": {
    "@id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^([A-Za-z][A-Za-z0-9\\-_]*:)?[A-Za-z0-9][A-Za-z0-9\\-_]*$"
        }
      ],
      "description": "Unique IRI identifying the documented resource.",
      "examples": [
        "tem-equip:ARM200F"
      ]
    },
    "@type": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^([A-Za-z][A-Za-z0-9\\-_]*:)?[A-Za-z0-9][A-Za-z0-9\\-_]*$"
        }
      ],
      "description": "IRI of the class the resource belongs to.",
      "examples": [
        "chameo:TransmissionElectronMicroscope"
      ]
    },
    "identifier": {
      "type": [
        "string",
        "null"
      ],
      "description": "URI or other unique identifier of the resource being described.",
      "examples": [
        "ARM200F"
      ]
    },
    "name": {
      "type": "string",
      "description": "A name of the agent.",
      "examples": [
        "ARM200F"
      ]
    },
    "description": {
      "type": "string",
      "description": "A free-text account of the resource.",
      "examples": [
        "Jeol JEM ARM200F - Double corrected ColdFEG microscope"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        null
      ]
    },
    "contactPerson": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "examples": [
        null
      ]
    },
    "comment": {
      "type": [
        "string",
        "null"
      ],
      "description": "A description of the subject resource. Use `description` instead.",
      "examples": [
        null
      ]
    },
    "seeAlso": {
      "type": [
        "string",
        "null"
      ],
      "description": "Indicates a resource that might provide additional information about the subject resource.",
      "examples": [
        "https://www.ntnu.edu/web/temgemini/tem/-/asset_publisher/2EWM49wMslOy/content/fgjgj"
      ]
    }
  },
  "required": [
    "@id",
    "@type",
    "name",
    "description"
  ]
}